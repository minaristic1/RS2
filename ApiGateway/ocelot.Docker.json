{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/invoices",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "billing-api",
          "Port": 5005
        }
      ],
      "UpstreamPathTemplate": "/api/invoices",
      "UpstreamHttpMethod": [
        "GET",
        "POST"
      ],
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "10s",
        "PeriodTimespan": 10,
        "Limit": 20
      }
    },
    {
      "DownstreamPathTemplate": "/api/invoices/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "billing-api",
          "Port": 5005
        }
      ],
      "UpstreamPathTemplate": "/api/invoices/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST"
      ],
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Period": "10s",
        "PeriodTimespan": 10,
        "Limit": 20
      }
    },
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/auth/{everything}",
      "UpstreamHttpMethod": [
        "POST"
      ],
      "RateLimitOptions": {
        "EnableRateLimiting": false
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5029",
    "RateLimitOptions": {
      "ClientIdHeader": "ClientId"
    }
  }
}
